<Window x:Class="RISpro.Scanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RISpro Scanner" Height="720" Width="920" MinHeight="620" MinWidth="760">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="RISpro Scanner" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Windows scanner companion for attaching paper documents to RISpro appointments." Foreground="#555" />
    </StackPanel>

    <TabControl Grid.Row="1">
      <TabItem Header="Setup">
        <ScrollViewer>
          <StackPanel Margin="12" MaxWidth="720">
            <TextBlock Text="RISpro server URL" FontWeight="SemiBold" />
            <TextBox x:Name="BaseUrlTextBox" Margin="0,4,0,12" />

            <CheckBox x:Name="AllowHttpCheckBox" Content="Allow HTTP for local development" Margin="0,0,0,12" />

            <TextBlock Text="Scanner" FontWeight="SemiBold" />
            <ComboBox x:Name="ScannerComboBox" Margin="0,4,0,12" />

            <WrapPanel Margin="0,0,0,12">
              <StackPanel Width="120" Margin="0,0,12,0">
                <TextBlock Text="DPI" />
                <ComboBox x:Name="DpiComboBox">
                  <ComboBoxItem Content="150" />
                  <ComboBoxItem Content="200" IsSelected="True" />
                  <ComboBoxItem Content="300" />
                </ComboBox>
              </StackPanel>
              <StackPanel Width="160" Margin="0,0,12,0">
                <TextBlock Text="Color" />
                <ComboBox x:Name="ColorModeComboBox">
                  <ComboBoxItem Content="grayscale" IsSelected="True" />
                  <ComboBoxItem Content="color" />
                </ComboBox>
              </StackPanel>
              <StackPanel Width="160">
                <TextBlock Text="Source" />
                <ComboBox x:Name="SourceComboBox">
                  <ComboBoxItem Content="feeder" IsSelected="True" />
                  <ComboBoxItem Content="flatbed" />
                </ComboBox>
              </StackPanel>
            </WrapPanel>

            <WrapPanel>
              <Button Content="Refresh scanners" Click="RefreshScanners_Click" Margin="0,0,8,0" />
              <Button Content="Save setup" Click="SaveSetup_Click" Margin="0,0,8,0" />
              <Button Content="Test scan" Click="TestScan_Click" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Scan session">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Appointment identity" FontWeight="SemiBold" />
              <TextBlock x:Name="ContextTextBlock" Text="Open RISpro and click Scan Paper to launch this app for an appointment." TextWrapping="Wrap" Margin="0,6,0,0" />
              <CheckBox x:Name="ConfirmIdentityCheckBox" Content="I confirm this is the correct patient and appointment" Margin="0,10,0,0" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Document type" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="DocumentTypeComboBox" Width="240">
              <ComboBoxItem Content="appointment_request" IsSelected="True" />
              <ComboBoxItem Content="previous_report" />
              <ComboBoxItem Content="consent" />
              <ComboBoxItem Content="id_document" />
              <ComboBoxItem Content="administrative_paper" />
              <ComboBoxItem Content="other" />
            </ComboBox>
          </StackPanel>

          <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
              <TextBlock Text="Preview" FontWeight="SemiBold" />
              <TextBlock x:Name="PreviewTextBlock" Text="No scanned PDF yet." Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Scan" Click="Scan_Click" Margin="0,0,8,0" />
            <Button Content="Upload" Click="Upload_Click" Margin="0,0,8,0" />
            <Button Content="Retry upload" Click="Upload_Click" Margin="0,0,8,0" />
            <Button Content="Cancel session" Click="Cancel_Click" />
          </WrapPanel>
        </Grid>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2" x:Name="StatusTextBlock" Text="Ready." Margin="0,12,0,0" TextWrapping="Wrap" />
  </Grid>
</Window>

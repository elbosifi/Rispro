# =============================================================================
# NCCB Diagnostic Radiology - Environment Configuration Template
# =============================================================================
# For first-time setup, run: ./scripts/setup-docker.sh
# It will generate a .env file with secure random credentials.
#
# This file is a reference template only. Do not copy it manually.
# =============================================================================

# -- Node.js Environment --
NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# -- Deployment Mode Markers (written by setup-docker.sh / update-docker.sh) --
# Set by the deployment scripts. Determines which compose files to use.
#   RISPRO_DB_MODE:
#     internal = use docker-compose.yml + docker-compose.internal-db.yml
#     external = use docker-compose.yml only
# RISPRO_DB_MODE=internal
#
#   RISPRO_DICOM_MODE:
#     embedded          = keep embedded RISpro MWL enabled
#     orthanc_internal  = deploy Orthanc in Docker and disable embedded MWL
#     orthanc_external  = connect to an external Orthanc and disable embedded MWL
# RISPRO_DICOM_MODE=embedded
#
#   RISPRO_MPPS_MODE:
#     disabled         = do not deploy the bridge
#     internal_bridge  = deploy the separate MPPS bridge container
# RISPRO_MPPS_MODE=disabled

# -- Database Connection --
#
# INTERNAL DATABASE (managed by Docker):
#   DATABASE_URL=postgresql://rispro:QOYR0s1h%2FuI7wqZrzW0gjNfQY61VwA6ek0wXsUEx6So%3D@postgres:5432/rispro
#   DB_USER=rispro
#   DB_PASSWORD=QOYR0s1h/uI7wqZrzW0gjNfQY61VwA6ek0wXsUEx6So=
#   DB_NAME=rispro
#
# EXTERNAL DATABASE (your own PostgreSQL server):
#   DATABASE_URL=postgresql://user:encoded-password@your-db-host:5432/rispro
#
# Note: Special characters in password must be URL-encoded.
#   @ = %40  : = %3A  / = %2F  # = %23  ? = %3F
#   & = %26  = = %3D  + = %2B  space = %20
DATABASE_URL=postgresql://rispro:QOYR0s1h%2FuI7wqZrzW0gjNfQY61VwA6ek0wXsUEx6So%3D@postgres:5432/rispro

# Optional: Internal database credentials (only used with docker-compose.internal-db.yml)
# DB_USER=rispro
# DB_PASSWORD=QOYR0s1h/uI7wqZrzW0gjNfQY61VwA6ek0wXsUEx6So=
# DB_NAME=rispro

# -- Database SSL --
# Internal Docker PostgreSQL: must be false.
# Internal Docker PostgreSQL also uses DATABASE_SSL_REJECT_UNAUTHORIZED=false.
# External PostgreSQL: set true only if your server supports SSL.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Optional: Fine-tune database connection
# DB_POOL_MAX=10

# -- Authentication --
# MUST be a long random string (min 32 characters)
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters
APPOINTMENT_PUBLIC_TOKEN_SECRET=replace-with-a-long-random-secret-minimum-32-characters
APPOINTMENT_PUBLIC_TOKEN_TTL_SECONDS=1209600
APPOINTMENT_PUBLIC_CANCEL_USER_ID=1
PUBLIC_APP_BASE_URL=https://rispro.nccb.com.ly

# -- OHIF Viewer --
# Supported setup/update scripts always deploy the viewer infrastructure. Clinical access remains
# disabled until Settings -> Integrations -> OHIF Viewer is enabled with a valid image source.
OHIF_ENABLED=true
COMPOSE_PROFILES=ohif
# Emergency deployment rollback only. true stops deployment and disables the application OHIF infrastructure gate.
OHIF_INFRASTRUCTURE_DISABLED=false
OHIF_PUBLIC_BASE_URL=/ohif
OHIF_DICOMWEB_PROXY_PATH=/ohif-dicomweb
OHIF_CONTAINER_URL=http://ohif:80
OHIF_CONTAINER_IMAGE=rispro-ohif:v3.12.6
OHIF_VERSION=v3.12.6
OHIF_SESSION_COOKIE_NAME=rispro_ohif_session
OHIF_LAUNCH_TOKEN_TTL_SECONDS=600
OHIF_RETRIEVAL_WORKER_INTERVAL_MS=5000
# Off by default. Shared Orthanc cleanup requires a proven, retrieval-owned resource ID.
OHIF_CACHE_CLEANUP_ENABLED=false
# Optional native DICOMweb credentials. Store only these variable names in Settings.
OHIF_DICOMWEB_USERNAME=
OHIF_DICOMWEB_PASSWORD=
OHIF_DICOMWEB_BEARER_TOKEN=

# -- Session Configuration --
COOKIE_NAME=rispro_session
# Set to true if behind HTTPS reverse proxy
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_HOURS=8

# -- Supervisor Re-authentication --
SUPERVISOR_REAUTH_MINUTES=10

# -- File Uploads --
REQUEST_BODY_LIMIT=75mb
UPLOADS_DIR=storage/uploads
# Persistent, non-public storage for DICOM remap jobs. In containers this must be on the shared /app/storage volume.
DICOM_REMAP_STAGING_DIR=storage/dicom/remap-staging
DICOM_REMAP_STAGING_MAX_FILES=5000
DICOM_REMAP_STAGING_MAX_TOTAL_BYTES=21474836480
DICOM_REMAP_PROCESSING_WORKER_INTERVAL_MS=5000
DICOM_REMAP_PROCESSING_LEASE_SECONDS=120
DICOM_REMAP_PROCESSING_BATCH_SIZE=5
DICOM_REMAP_FAILED_STAGING_RETENTION_HOURS=72
DICOM_REMAP_AWAITING_CONFIRMATION_RETENTION_HOURS=24

# -- Appointment Request Scanning --
# Runtime scanner configuration is controlled in RISpro UI:
# Settings -> Documents & Uploads.
NAPS2_WEBSCAN_ENABLED=false
# Optional fallback/legacy override for the local RISpro Scanner Bridge endpoint.
NAPS2_WEBSCAN_ENDPOINT=

# -- DICOM Deployment --
# The deployment scripts automatically keep these aligned with the selected mode.
# RISPRO_DISABLE_EMBEDDED_DICOM_GATEWAY=0
# RISPRO_APP_IMAGE_TARGET=production

# -- Orthanc MWL Sync (External Projection) --
# RISpro remains source of truth. Orthanc is an external synchronized MWL target.
# In orthanc_internal mode the setup/update scripts auto-fill ORTHANC_BASE_URL
# with http://orthanc:8042 and generate the Orthanc config automatically.
ORTHANC_MWL_ENABLED=false
ORTHANC_MWL_SHADOW_MODE=false
ORTHANC_BASE_URL=
ORTHANC_TIMEOUT_SECONDS=10
ORTHANC_VERIFY_TLS=true
ORTHANC_AUTH_ENABLED=false
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
ORTHANC_WORKLIST_TARGET=

# -- Sante Worklist Server HL7 File-Drop --
# Runtime configuration is controlled in RISpro UI:
# Settings -> Sante Worklist Server.
# These values are bootstrap/safety fallbacks only.
# The output folder must be visible to the RISpro backend/container.
# Mount the Windows Sante import share into one of the allowed base paths.
SANTE_HL7_ENABLED=false
SANTE_HL7_OUTPUT_FOLDER_PATH=/app/storage/sante-hl7-outbox
SANTE_HL7_ALLOWED_BASE_PATHS=/app/storage/sante-hl7-outbox
SANTE_HL7_HOST_OUTBOX_HINT=storage/sante-hl7-outbox
SANTE_HL7_WINDOWS_SHARE_SOURCE_HINT=storage\sante-hl7-outbox

# -- MPPS Bridge --
# Deployed as a separate service only when RISPRO_MPPS_MODE=internal_bridge.
MPPS_BRIDGE_PORT=11113
MPPS_BRIDGE_AE_TITLE=RISPRO_MPPS
MPPS_AUTH_ENABLED=false
MPPS_USERNAME=
MPPS_PASSWORD=

# -- Request Scan Worker --
# The Compose app disables its embedded worker and runs this in request-scan-worker.
# Leave enabled for legacy/non-Compose deployment rollback.
REQUEST_SCAN_WORKER_PROCESS_ENABLED=true
# Two independent Request Scan files may process at once; each document remains sequential.
# Set to 1 and restart the worker to restore sequential file processing. Values above 2 are unsupported.
REQUEST_SCAN_MAX_CONCURRENCY=1
# Compose operator controls. Keep the dedicated default sequential until the concurrency smoke is approved.
REQUEST_SCAN_APP_WORKER_ENABLED=false
REQUEST_SCAN_DEDICATED_WORKER_ENABLED=true
REQUEST_SCAN_DEDICATED_MAX_CONCURRENCY=1
# Development/test only. The backend also refuses this feature when NODE_ENV=production.
RISPRO_REQUEST_SCAN_DEV_RESET_ENABLED=false

# -- Initial Supervisor Account (used only for first-time seeding) --
SEED_SUPERVISOR_USERNAME=admin
SEED_SUPERVISOR_PASSWORD=admin
SEED_SUPERVISOR_FULL_NAME=System Administrator
# QZ Tray silent printing (keep the private key only on the RISpro server).
# Store PEM newlines as literal \n sequences when the deployment platform does not support multiline values.
QZ_CERTIFICATE=
QZ_PRIVATE_KEY=

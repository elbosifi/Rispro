    "@tanstack/react-query": "^5.96.2",
    "@types/qrcode": "^1.5.6",
    "dicom-parser": "^1.8.21",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.8.0",
    "pdfjs-dist": "5.4.296",
    "qrcode": "^1.5.4",
    "qz-tray": "^2.2.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-pdf": "10.4.1",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",

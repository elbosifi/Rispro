NODE_ENV=production
PORT=3000
TRUST_PROXY=1
RISPRO_DB_MODE=internal
RISPRO_DICOM_MODE=embedded
RISPRO_MPPS_MODE=disabled
DATABASE_URL=postgresql://rispro_validation:rispro_validation_password@postgres:5432/rispro_validation
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
JWT_SECRET=restore-validation-jwt-secret-0000000000000000
COOKIE_NAME=rispro_validation_session
REAUTH_COOKIE_NAME=rispro_validation_supervisor_reauth
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_HOURS=8
SUPERVISOR_REAUTH_MINUTES=10
REQUEST_BODY_LIMIT=75mb
UPLOADS_DIR=/app/storage/uploads
SCAN_SESSION_TOKEN_SECRET=restore-validation-scan-secret-0000000000
NAPS2_WEBSCAN_ENABLED=false
NAPS2_WEBSCAN_ENDPOINT=
SEED_SUPERVISOR_USERNAME=admin
SEED_SUPERVISOR_PASSWORD=restoreValidationAdmin123!
SEED_SUPERVISOR_FULL_NAME=Validation Supervisor
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_PASSWORD=restoreValidationSuperAdmin123!
SEED_SUPER_ADMIN_FULL_NAME=Validation Super Admin
ORTHANC_AUTH_ENABLED=false
ORTHANC_MWL_ENABLED=false
ORTHANC_MWL_SHADOW_MODE=false
ORTHANC_BASE_URL=
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
ORTHANC_TIMEOUT_SECONDS=10
ORTHANC_VERIFY_TLS=true
ORTHANC_WORKLIST_TARGET=
SANTE_HL7_ENABLED=false
SANTE_HL7_OUTPUT_FOLDER_PATH=/app/storage/sante-hl7-outbox
SANTE_HL7_ALLOWED_BASE_PATHS=/app/storage/sante-hl7-outbox
SANTE_HL7_HOST_OUTBOX_HINT=storage/sante-hl7-outbox
SANTE_HL7_WINDOWS_SHARE_SOURCE_HINT=storage\sante-hl7-outbox
MPPS_BRIDGE_PORT=11113
MPPS_BRIDGE_AE_TITLE=RISPRO_MPPS
MPPS_AUTH_ENABLED=false
MPPS_USERNAME=
MPPS_PASSWORD=
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_REMINDER_HOURS=24
WEB_PUSH_WORKER_INTERVAL_SECONDS=60
WEB_PUSH_DELIVERY_MAX_ATTEMPTS=5
WEB_PUSH_REPORT_READY_SCAN_INTERVAL_SECONDS=300
WEB_PUSH_REPORT_READY_LOOKBACK_DAYS=14
WEB_PUSH_REPORT_READY_MAX_CHECKS_PER_RUN=25
DOCTOR_PORTAL_ENABLED=true
DOCTOR_PORTAL_AUTO_REDIRECT=true
RESTORE_V3_FULL_ENABLED=true
RESTORE_V3_DB_ONLY_ENABLED=false
LOCAL_ONLY_STAGING_KEY=preserve-me
